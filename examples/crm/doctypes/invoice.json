{
  "name": "invoice",
  "label": "Invoice",
  "module": "CRM",
  "autoname": "format:INV-{YYYY}-{####}",
  "fields": [
    { "fieldname": "customer", "label": "Customer", "fieldtype": "Link", "options": "customer", "reqd": true, "in_list_view": true },
    { "fieldname": "invoice_date", "label": "Date", "fieldtype": "Date", "default": "Today", "in_list_view": true },
    { "fieldtype": "Column Break" },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Draft\nSent\nPaid", "default": "Draft", "in_list_view": true },
    { "fieldtype": "Section Break", "label": "Items" },
    { "fieldname": "items", "label": "Items", "fieldtype": "Table", "options": "invoice_item" },
    { "fieldtype": "Section Break", "label": "Totals" },
    { "fieldname": "subtotal", "label": "Subtotal", "fieldtype": "Currency", "read_only": true },
    { "fieldname": "gst_percent", "label": "GST %", "fieldtype": "Float", "default": "18" },
    { "fieldtype": "Column Break" },
    { "fieldname": "gst_amount", "label": "GST", "fieldtype": "Currency", "read_only": true },
    { "fieldname": "total", "label": "Total", "fieldtype": "Currency", "read_only": true, "in_list_view": true }
  ]
}
